{
  "name": "kraken-vtt",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "version": "0.1.0-alpha.87",
  "description": "A free virtual tabletop: the GM hosts, players join from a browser.",
  "author": "Kraken VTT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsx scripts/check-morning.ts && tsx scripts/check-foundry-parity.ts",
    "shot": "node scripts/shot-scene.mjs",
    "map": "node scripts/check-map.mjs",
    "party": "node scripts/check-party.mjs",
    "combat": "node scripts/check-combat.mjs",
    "attack": "node scripts/check-attack.mjs",
    "spells": "node scripts/check-spells.mjs",
    "popout": "node scripts/check-popout.mjs",
    "setup": "node scripts/check-setup.mjs",
    "dice": "node scripts/check-dice.mjs && tsx scripts/check-dice-throw.ts",
    "chat": "node scripts/check-chat.mjs",
    "sound": "node scripts/check-sound.mjs",
    "sound-ui": "node scripts/verify-sound-ui.mjs",
    "books": "node scripts/check-books.mjs",
    "books-ui": "node scripts/verify-books-ui.mjs",
    "packs": "node scripts/check-packs.mjs",
    "build-packs": "node scripts/build-packs.mjs",
    "clean-install-ui": "node scripts/verify-clean-install.mjs",
    "quickslots-ui": "node scripts/verify-quickslots-ui.mjs",
    "rulesets-ui": "node scripts/verify-rulesets-ui.mjs",
    "image-window-ui": "node scripts/verify-image-window-ui.mjs",
    "studio-ui": "node scripts/verify-studio-ui.mjs",
    "table-play-ui": "node scripts/verify-table-play-ui.mjs",
    "calendar-notes-ui": "node scripts/verify-calendar-notes-ui.mjs",
    "dicepacks-ui": "node scripts/verify-dicepacks-ui.mjs",
    "tower-ui": "node scripts/verify-tower-ui.mjs",
    "book-pictures-ui": "node scripts/verify-book-pictures-ui.mjs",
    "active-books-ui": "node scripts/verify-active-books-ui.mjs",
    "image-chrome-ui": "node scripts/verify-image-chrome-ui.mjs",
    "restore-ui": "node scripts/verify-restore-ui.mjs",
    "updater-ui": "node scripts/verify-updater-ui.mjs",
    "packs-ui": "node scripts/verify-packs-ui.mjs",
    "dnd35": "node scripts/check-dnd35.mjs",
    "dnd35-ui": "node scripts/verify-dnd35-ui.mjs",
    "adnd2e": "node scripts/check-adnd2e.mjs",
    "adnd2e-ui": "node scripts/verify-adnd2e-ui.mjs",
    "bfrpg": "node scripts/check-bfrpg.mjs",
    "bfrpg-ui": "node scripts/verify-bfrpg-ui.mjs",
    "dice-hold": "node scripts/verify-dice-hold.mjs",
    "mgt2": "node scripts/check-mgt2.mjs",
    "mgt2-ui": "node scripts/verify-mgt2-ui.mjs",
    "tcwizard": "node scripts/check-tcwizard.mjs",
    "starships": "node scripts/check-starships.mjs",
    "starships-ui": "node scripts/verify-starships-ui.mjs",
    "order-ui": "node scripts/verify-order-ui.mjs",
    "maptools-ui": "node scripts/verify-maptools-ui.mjs",
    "notes-ui": "node scripts/verify-notes-ui.mjs",
    "sounds": "node --env-file=.env.local scripts/generate-sounds.mjs",
    "decal": "node scripts/check-decal.mjs",
    "sight-parity": "node scripts/check-sight-parity.mjs",
    "session": "node scripts/check-session.mjs",
    "agent": "node scripts/check-agent.mjs",
    "assistant": "node scripts/check-assistant.mjs",
    "agent-ui": "node scripts/check-agent-ui.mjs",
    "coverage": "node scripts/check-coverage.mjs",
    "import-check": "node scripts/check-import.mjs",
    "pregens": "node scripts/check-pregens.mjs",
    "character": "node scripts/check-character.mjs",
    "wizard": "node scripts/check-wizard.mjs",
    "bump": "node scripts/bump-version.mjs",
    "interchange": "node scripts/check-interchange.mjs",
    "krits": "node scripts/check-krits.mjs",
    "combine": "node scripts/check-combine.mjs",
    "combine-fg": "node scripts/check-combine-fg.mjs",
    "walls": "node scripts/check-walls.mjs",
    "tiles": "tsx scripts/check-tiles.mjs",
    "dnd5e": "node scripts/check-dnd5e.mjs",
    "audit": "node scripts/check-audit.mjs",
    "dnd5e-fg": "node scripts/check-dnd5e-fg.mjs",
    "library": "node scripts/check-library.mjs",
    "library-ui": "node scripts/verify-library-ui.mjs",
    "playtest": "node scripts/playtest-b2.mjs",
    "mapedit-ui": "node scripts/verify-mapedit-ui.mjs",
    "picture-map-ui": "node scripts/verify-picture-map-ui.mjs",
    "copy-ui": "node scripts/verify-copy-ui.mjs",
    "lan-join-ui": "node scripts/verify-lan-join-ui.mjs",
    "charselect-ui": "node scripts/verify-charselect-ui.mjs",
    "records-ui": "node scripts/verify-records-ui.mjs",
    "gmname-ui": "node scripts/verify-gmname-ui.mjs",
    "accounts-ui": "node scripts/verify-accounts-ui.mjs",
    "prefs-ui": "node scripts/verify-prefs-ui.mjs",
    "walls-ui": "node scripts/verify-walls-ui.mjs",
    "descending-ui": "node scripts/verify-descending-ui.mjs",
    "astra-ui": "node scripts/verify-astra-ui.mjs",
    "backdrops": "node scripts/verify-backdrops.mjs",
    "build-games": "node scripts/build-content.mjs",
    "responsive-ui": "node scripts/verify-responsive-ui.mjs",
    "maptiles-ui": "node scripts/verify-maptiles-ui.mjs",
    "combat-hand-ui": "node scripts/verify-combat-hand-ui.mjs",
    "doors": "node scripts/check-doors.mjs",
    "doors-ui": "node scripts/verify-doors-ui.mjs",
    "animated-art-ui": "node scripts/verify-animated-art-ui.mjs",
    "checks": "node scripts/run-checks.mjs",
    "dnd5e-ui": "node scripts/verify-dnd5e-ui.mjs",
    "demo": "node scripts/demo-host.mjs",
    "start": "electron .",
    "launch": "node scripts/launch.mjs",
    "exe": "npm run build && node scripts/build-packs.mjs && electron-builder --win nsis --publish never && node scripts/copy-exe.mjs",
    "linux": "npm run build && node scripts/build-packs.mjs && electron-builder --linux AppImage deb --publish never",
    "map-share-ui": "node scripts/verify-map-share-ui.mjs",
    "natural-sound-ui": "node scripts/verify-natural-sound-ui.mjs",
    "player-sound-ui": "node scripts/verify-player-sound-ui.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fontsource/cinzel": "^5.3.0",
    "@xmldom/xmldom": "^0.8.10",
    "cannon-es": "^0.20.0",
    "electron-updater": "^6.8.11",
    "fengari": "^0.1.5",
    "fengari-interop": "^0.1.4",
    "fflate": "^0.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.34.5",
    "three": "^0.170.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "vtt.kraken",
    "productName": "Kraken VTT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "sounds/**/*",
      "shared/**/*",
      "games/packs/**/*",
      "games/portraits/**/*",
      "games/tokens/**/*",
      "skills/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/ws/**/*",
      "node_modules/fflate/**/*",
      "node_modules/@xmldom/**/*",
      "node_modules/fengari/**/*",
      "node_modules/fengari-interop/**/*",
      "node_modules/readline-sync/**/*",
      "node_modules/sprintf-js/**/*",
      "node_modules/tmp/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/semver/**/*",
      "studio/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/sax/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "krakenunbound",
        "repo": "kraken-vtt",
        "releaseType": "prerelease"
      }
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "include": "build/installer.nsh",
      "artifactName": "Kraken-VTT-Setup.exe",
      "shortcutName": "Kraken VTT",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "synopsis": "A virtual tabletop: the GM hosts, players join from a browser",
      "maintainer": "The Kraken <krakenunbound@users.noreply.github.com>",
      "executableName": "kraken-vtt",
      "artifactName": "Kraken-VTT-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Kraken VTT"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "artifactName": "kraken-vtt_${version}_${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/krakenunbound/kraken-vtt",
  "desktopName": "kraken-vtt.desktop"
}
