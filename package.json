{
  "name": "kraken-vtt",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsx scripts/check-morning.ts && tsx scripts/check-foundry-parity.ts",
    "shot": "node scripts/shot-scene.mjs",
    "map": "node scripts/check-map.mjs",
    "party": "node scripts/check-party.mjs",
    "sight-parity": "node scripts/check-sight-parity.mjs",
    "session": "node scripts/check-session.mjs",
    "agent": "node scripts/check-agent.mjs",
    "import-check": "node scripts/check-import.mjs",
    "pregens": "node scripts/check-pregens.mjs",
    "character": "node scripts/check-character.mjs",
    "wizard": "node scripts/check-wizard.mjs",
    "demo": "node scripts/demo-host.mjs",
    "start": "electron .",
    "exe": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "fflate": "^0.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.170.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "vtt.kraken",
    "productName": "Kraken VTT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "node_modules/ws/**/*",
      "node_modules/fflate/**/*",
      "node_modules/@xmldom/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Kraken VTT.exe"
    }
  }
}
